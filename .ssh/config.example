# WARP コンテナを踏み台にして接続する SSH 設定のひな形。
# .\scripts\access.ps1 の初回実行時に .ssh\config へコピーされ、__...__ の値を対話式に設定する。
# (__CONTAINER__ は docker\.env の CONTAINER_NAME、未設定なら cloudflare-zerotrust-proxy が自動で入る)
# 手で作る場合は .ssh\config にコピーして __...__ を書き換える (.ssh\config は git の管理対象外)。

Host __HOST_ALIAS__
    HostName __HOST_NAME__
    Port 22
    User __USER__
    # 鍵を指定する場合はコメントを外す (未指定なら ~/.ssh の既定の鍵 / パスワード認証)
    # IdentityFile ~/.ssh/id_rsa
    # IdentitiesOnly yes
    HostKeyAlias __HOST_ALIAS__
    ProxyCommand docker exec -i __CONTAINER__ nc %h %p
    ServerAliveInterval 30
    ServerAliveCountMax 4
