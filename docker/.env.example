# 環境に合わせて設定する場合のみ .env にコピーして使う (無くても動く)

# 起動するコンテナの名称 (小文字の英数字とハイフン)
# compose のプロジェクト名・コンテナ名・ホスト名 (= Zero Trust 側のデバイス名) に使われる。
# 変えると登録情報の volume も別になるので、再登録が必要。
# SSH の ProxyCommand (.ssh/config と ~/.ssh/config) のコンテナ名も合わせる。
CONTAINER_NAME=cloudflare-zerotrust-proxy

# ホスト側 (127.0.0.1) で公開する SOCKS5 ポート
SOCKS_PORT=1080
